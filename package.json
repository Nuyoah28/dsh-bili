{
  "name": "dsh-bili-scroll",
  "version": "0.4.0-local.1",
  "description": "本地 B站视频资料库：按链接归档视频、字幕和截图，导出收藏夹列表",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "mcp",
    "duty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c1overzz/dsh-bili-scroll.git"
  },
  "homepage": "https://github.com/c1overzz/dsh-bili-scroll#readme",
  "bugs": {
    "url": "https://github.com/c1overzz/dsh-bili-scroll/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "vendor",
    "README.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE",
    "NOTICE.md",
    "CONTRIBUTORS.md",
    "bili_library/*.py",
    "requirements-library.txt",
    "tools/library.mjs",
    "bili_library/web/*",
    "tools/library.env.example",
    "tools/mcp-smoke.py",
    "deploy/*.example",
    "deploy/*.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "bili-library": "./tools/library.mjs"
  },
  "scripts": {
    "library": "node tools/library.mjs",
    "test:library": "python3 -m unittest discover -s tests -v",
    "web": "node tools/library.mjs web"
  }
}
