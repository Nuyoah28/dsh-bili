# Copy to repository-root library.env, edit, then source it in your shell.
# This is shell syntax; it is NOT loaded automatically by the launcher.
BILI_LIBRARY_HOME="$HOME/.dsh/bili-duty/library"
BILI_WEB_PORT=8765
BILI_REMOTE_WRITES=0
# Point at your own private or PATH-installed media tools:
# BILI_FFMPEG=/absolute/path/to/ffmpeg
# BILI_FFPROBE=/absolute/path/to/ffprobe
# Normally setup creates and selects its own Python; override only if needed:
# BILI_LIBRARY_PYTHON=/absolute/path/to/python3
# Optional existing token (24+ chars). Leave UNSET to use secrets/web-token.
# Never commit an actual token here.
# BILI_WEB_TOKEN=your-own-random-token-with-at-least-24-characters
